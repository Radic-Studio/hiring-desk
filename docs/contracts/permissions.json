{
  "$comment": "Who may do what. Enforced by the database (row-level security, named functions, storage policies), never by the screens. The screens use this only to hide buttons a person cannot use. Source: live policies, 26 Oct 2026 (supabase/schema/schema_snapshot.sql).",
  "version": "2026-10-26",
  "actors": {
    "group_admin": "members.level = 'editor' and status 'active'. Acts as Company Admin in every company (my_company_role returns 'admin').",
    "company_admin": "company_members.role = 'admin' for that company",
    "manager": "company_members.role = 'manager' for that company",
    "staff": "company_members.role = 'staff' for that company",
    "viewer": "company_members.role = 'viewer' for that company",
    "member_no_company": "active member with no role in this company",
    "self": "the staff record whose member_email is the signed-in person's email",
    "customer": "signed-in portal account with no members row",
    "anon": "not signed in"
  },
  "helpers": {
    "is_admin()": "group_admin",
    "my_company_role(c) is not null": "group_admin, company_admin, manager, staff, viewer",
    "can_write_company(c)": "group_admin, company_admin, manager, staff",
    "can_manage_company(c)": "group_admin, company_admin, manager",
    "is_company_admin(c)": "group_admin, company_admin",
    "my_level() is not null": "any active member"
  },
  "deleted_rows": "Soft-deleted rows are invisible to everyone except Group Admins (restrictive *_hide_deleted). Hard delete is refused for everyone except Group Admins (restrictive *_no_hard_delete), and the app only hard-deletes through purge_deleted().",
  "tables": {
    "candidates":            { "read": ["group_admin"], "write": ["group_admin"] },
    "roles":                 { "read": ["group_admin"], "write": ["group_admin"] },
    "issues":                { "read": ["group_admin"], "write": ["group_admin"] },
    "settings":              { "read": ["any member"], "write": ["group_admin via save_app_settings"] },
    "companies":             { "read": ["any member"], "write": ["group_admin via admin_save_company"] },
    "members":               { "read": ["any member"], "write": ["named functions only (admin_*, request_access, update_my_profile, accept_invite)"] },
    "company_members":       { "read": ["any member"], "write": ["named functions only (admin_approve, admin_invite, admin_set_company_role)"] },
    "company_settings":      { "read": ["company role"], "write": ["company_admin via save_company_settings"] },
    "staff":                 { "read": ["company role (directory: name, position, phone, email, photo, status)", "also companies listed in staff.companies"], "write": ["manager"] },
    "staff_private":         { "read": ["manager", "self"], "write": ["manager"], "fields": ["address", "date_of_birth", "emergency_name", "emergency_phone", "notes"] },
    "staff_documents":       { "read": ["manager", "self"], "write": ["manager"] },
    "leave_requests":        { "read": ["manager", "requester", "self (leave on own staff record)"], "insert": ["manager", "self (for own staff record)"], "cancel": ["requester while pending"], "decide": ["manager via leave_decide"], "calendar": ["company role via leave_calendar (approved leave only: name and dates, no reason)"] },
    "press_customers":       { "read": ["company role"], "write": ["staff"] },
    "press_jobs":            { "read": ["company role"], "write": ["staff"] },
    "press_payments":        { "read": ["company role"], "insert": ["staff"], "update": ["none (records are corrected by a new payment or a Group Admin)"] },
    "press_files":           { "read": ["company role"], "write": ["staff"] },
    "press_rate_items":      { "read": ["company role"], "write": ["manager"] },
    "press_materials":       { "read": ["company role"], "write": ["manager"] },
    "press_material_moves":  { "read": ["company role"], "insert": ["staff (quantity follows automatically)"] },
    "customer_requests":     { "read": ["customer (own)", "company role"], "insert": ["customer via portal_submit_request"], "update": ["staff"] },
    "customer_request_messages": { "read": ["customer (own request)", "company role"], "insert": ["customer (own request, author 'customer')", "staff (author 'staff')"] },
    "customer_request_files":    { "read": ["customer (own request)", "company role"], "insert": ["customer via portal_attach_file"] },
    "portal_profiles":       { "read": ["customer (own)", "company role of a company the customer has a request with"], "write": ["customer (own)"] },
    "conflicts":             { "read": ["group_admin", "the person whose change clashed"], "resolve": ["group_admin via resolve_conflict"] },
    "deletions":             { "read": ["group_admin"], "restore": ["group_admin via restore_deleted"], "purge": ["group_admin via purge_deleted"] },
    "ops_log":               { "read": ["group_admin"], "write": ["database triggers and functions only"] },
    "sync_runs":             { "read": ["group_admin"], "last_success_time": ["any member via backup_last_success"], "write": ["backup service only"] },
    "op_receipts":           { "read": ["none"], "write": ["apply_op only"] },
    "app_config":            { "read": ["none (service only)"], "write": ["service only"] },
    "member_invites":        { "read": ["none"], "write": ["admin_invite / accept_invite only"] }
  },
  "actions": {
    "soft_delete":        { "who": { "roles, candidates, issues": "group_admin", "press_customers, press_jobs, press_files, customer_requests": "staff and above", "everything else (staff, staff_private, staff_documents, leave_requests, press_payments, press_rate_items, press_materials)": "manager and above" }, "note": "children are deleted with the parent in one batch (soft_can_delete)" },
    "restore_deleted":    { "who": "group_admin" },
    "purge_deleted":      { "who": "group_admin", "confirm": "type the record's label exactly" },
    "resolve_conflict":   { "who": "group_admin", "choices": ["keep_current", "take_incoming", "merged"] },
    "admin_invite":       { "who": "group_admin; company_admin for own company (not Group Admin level)" },
    "admin_approve":      { "who": "group_admin; company_admin for own company" },
    "admin_set_member":   { "who": "group_admin" },
    "admin_set_company_role": { "who": "group_admin; company_admin for own company" },
    "admin_remove_member":{ "who": "group_admin", "guard": "cannot remove the last Group Admin" },
    "admin_save_company": { "who": "group_admin" },
    "send_email (candidates)": { "who": "can_write_company of the candidate's company (Hiring: group_admin)" },
    "send_doc (quotes, invoices, receipts)": { "who": "staff and above", "limit": "60 per sender per hour" }
  },
  "storage": {
    "avatars":        { "public_read": true, "write": "own folder (uid); staff/ folder by managers", "note": "staff photos are publicly readable by URL (random path). LOW." },
    "staff-docs":     { "read": "manager or the staff member", "write": "manager", "delete": "manager" },
    "press-files":    { "read": "company role", "write": "staff", "delete": "staff" },
    "customer-files": { "read": "the customer (own folder) or company role", "write": "the customer (own folder)" }
  }
}
